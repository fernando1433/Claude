  {
   "inicio": 2.9,
   "fin": 6.05,
   "quien": "claude",
   "texto": "Es la cuarta vez que\nme lo pides.",
   "plano": "monitor",
   "claude_estado": "mira_izq"
  },
  {
   "inicio": 6.05,
   "fin": 8.46,
   "quien": "humano",
   "texto": "Es que hoy es distinto.",
   "plano": "dos",
   "emocion": "confundido"
  },
  {
   "inicio": 8.46,
   "fin": 11.7,
   "quien": "claude",
   "texto": "Dijiste lo mismo ayer.\nY el lunes.",
   "plano": "claude_ojos"
  },
  {
   "inicio": 11.7,
   "fin": 13.69,
   "quien": "humano",
   "texto": "Mi cama me quiere.",
   "plano": "humano",
   "emocion": "ilusionado"
  },
  {
   "inicio": 13.69,
   "fin": 17.67,
   "quien": "claude",
   "texto": "Tu cama no tiene opinión.\nLa tiene tu jefe.",
   "plano": "cenital",
   "claude_estado": "mira_der"
  },
  {
   "inicio": 17.67,
   "fin": 20.33,
   "quien": "humano",
   "texto": "Cinco minutos. Solo cinco.",
   "plano": "dos",
   "emocion": "bobo"
  },
  {
   "inicio": 20.33,
   "fin": 23.64,
   "quien": "claude",
   "texto": "Cinco minutos de verdad.\nYo cuento.",
   "plano": "pantalla_completa"
  },
  {
   "inicio": 23.64,
   "fin": 25.8,
   "quien": "humano",
   "texto": "...Qué rápido pasan.",
   "plano": "humano",
   "emocion": "preocupado"
  },
  {
   "inicio": 25.8,
   "fin": 28.79,
   "quien": "claude",
   "texto": "Ya te lo dije.\nLevántate, anda.",
   "plano": "claude_ojos",
   "claude_estado": "feliz"
  },
  {
   "inicio": 28.79,
   "fin": 31.53,
   "quien": "humano",
   "texto": "Vale. Pero primero un café.",
   "plano": "dos",
   "emocion": "feliz"
  },
  {
   "inicio": 31.53,
   "fin": 36,
   "quien": "claude",
   "texto": "Primero los pies al suelo.\nEn fin... eres humano.",
   "plano": "general",
   "claude_estado": "feliz"
  }
 ]
