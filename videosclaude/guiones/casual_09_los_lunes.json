    "duracion": 20.11
   }
  },
  {
   "inicio": 3.06,
   "fin": 5.66,
   "quien": "claude",
   "texto": "Porque antes hay un domingo.",
   "plano": "monitor"
  },
  {
   "inicio": 5.66,
   "fin": 7.8,
   "quien": "humano",
   "texto": "¿Y no se puede quitar?",
   "plano": "dos",
   "emocion": "bobo"
  },
  {
   "inicio": 7.8,
   "fin": 11.77,
   "quien": "claude",
   "texto": "Quitamos el lunes y\nel martes pasa a ser lunes.",
   "plano": "claude_ojos",
   "claude_estado": "mira_izq"
  },
  {
   "inicio": 11.77,
   "fin": 14.45,
   "quien": "humano",
   "texto": "Entonces quitamos los martes.",
   "plano": "humano",
   "emocion": "ilusionado"
  },
  {
   "inicio": 14.45,
   "fin": 19.1,
   "quien": "claude",
   "texto": "Y el miércoles. Ya tienes\nel mismo problema, más barato.",
   "plano": "pantalla_completa"
  },
  {
   "inicio": 19.1,
   "fin": 21.78,
   "quien": "humano",
   "texto": "Odio las reuniones del lunes.",
   "plano": "dos",
   "emocion": "preocupado"
  },
  {
   "inicio": 21.78,
   "fin": 25.14,
   "quien": "claude",
   "texto": "Esa reunión podía ser\nun correo. Lo sé.",
   "plano": "cenital",
   "claude_estado": "mira_der"
  },
  {
   "inicio": 25.14,
   "fin": 27.05,
   "quien": "humano",
   "texto": "¿Entonces qué hago?",
   "plano": "humano",
   "emocion": "confundido"
  },
  {
   "inicio": 27.05,
   "fin": 30.19,
   "quien": "claude",
   "texto": "Café, paciencia y\nuna reunión menos.",
   "plano": "monitor",
   "claude_estado": "feliz"
  },
  {
   "inicio": 30.19,
   "fin": 31.95,
   "quien": "humano",
   "texto": "Eres un sabio.",
   "plano": "dos",
   "emocion": "ilusionado"
  },
  {
   "inicio": 31.95,
   "fin": 36,
   "quien": "claude",
   "texto": "Soy un lunes con teclado.\nEn fin... eres humano.",
   "plano": "general",
   "claude_estado": "feliz"
  }
 ]
