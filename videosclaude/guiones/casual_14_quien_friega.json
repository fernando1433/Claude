   "texto": "Yo. Pero cocinar es más difícil.",
   "plano": "humano",
   "emocion": "ilusionado"
  },
  {
   "inicio": 12.19,
   "fin": 14.79,
   "quien": "claude",
   "texto": "Eso lo dice quien cocinó.",
   "plano": "cenital",
   "claude_estado": "mira_der"
  },
  {
   "inicio": 14.79,
   "fin": 16.98,
   "quien": "humano",
   "texto": "¿Y si friego mañana?",
   "plano": "dos",
   "emocion": "bobo"
  },
  {
   "inicio": 16.98,
   "fin": 21.67,
   "quien": "claude",
   "texto": "Mañana habrá más platos.\nLas matemáticas no fallan.",
   "plano": "monitor",
   "claude_estado": "feliz"
  },
  {
   "inicio": 21.67,
   "fin": 24.85,
   "quien": "humano",
   "texto": "Propongo piedra, papel o tijera.",
   "plano": "humano",
   "emocion": "ilusionado"
  },
  {
   "inicio": 24.85,
   "fin": 29.87,
   "quien": "claude",
   "texto": "Propongo una tabla de turnos.\nY que los dos queden mal.",
   "plano": "pantalla_completa"
  },
  {
   "inicio": 29.87,
   "fin": 31.81,
   "quien": "humano",
   "texto": "¿Y si pierdo yo?",
   "plano": "dos",
   "emocion": "preocupado"
  },
  {
   "inicio": 31.81,
   "fin": 36,
