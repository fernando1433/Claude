   "emocion": "preocupado"
  },
  {
   "inicio": 20.94,
   "fin": 24.82,
   "quien": "claude",
   "texto": "Es el café. Bebe agua.\nY siéntate.",
   "plano": "pantalla_completa"
  },
  {
