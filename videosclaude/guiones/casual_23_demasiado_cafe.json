   "emocion": "ilusionado"
  },
  {
   "inicio": 14.07,
   "fin": 18.64,
   "quien": "claude",
   "texto": "Tampoco tienes calma.\nTe tiembla la mano.",
   "plano": "cenital",
   "claude_estado": "mira_der"
  },
  {
