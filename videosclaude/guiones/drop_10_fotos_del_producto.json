  },
  {
   "inicio": 4.33,
   "fin": 6.23,
   "quien": "claude",
   "texto": "¿Cómo las haces?",
   "plano": "monitor",
   "claude_estado": "mira_izq"
  },
  {
   "inicio": 6.23,
   "fin": 8.93,
   "quien": "humano",
   "texto": "Con el flash. En la cocina.",
   "plano": "dos",
   "emocion": "bobo"
  },
  {
   "inicio": 8.93,
   "fin": 12.37,
   "quien": "claude",
   "texto": "Ahí está el problema:\nflash y cocina.",
   "plano": "claude_ojos",
   "claude_estado": "feliz"
  },
  {
   "inicio": 12.37,
   "fin": 14.26,
   "quien": "humano",
   "texto": "¿Qué cambio?",
   "plano": "humano",
   "emocion": "confundido"
  },
  {
   "inicio": 14.26,
   "fin": 19.24,
   "quien": "claude",
   "texto": "Luz natural, junto a una ventana.\nSin flash. Fondo liso.",
   "plano": "cenital",
   "claude_estado": "mira_der"
  },
  {
   "inicio": 19.24,
   "fin": 21.14,
   "quien": "humano",
   "texto": "¿Cuántas fotos?",
   "plano": "dos",
   "emocion": "bobo"
  },
  {
   "inicio": 21.14,
   "fin": 25.55,
   "quien": "claude",
   "texto": "Varias: de frente, de lado,\ndetalle y una de uso.",
   "plano": "pantalla_completa"
  },
  {
   "inicio": 25.55,
   "fin": 27.93,
   "quien": "humano",
   "texto": "¿Y si le añado filtros?",
   "plano": "humano",
   "emocion": "ilusionado"
  },
  {
   "inicio": 27.93,
   "fin": 32.1,
   "quien": "claude",
   "texto": "No. Que el cliente reciba\nlo que ve. O vuelve.",
   "plano": "monitor",
   "claude_estado": "feliz"
  },
  {
   "inicio": 32.1,
   "fin": 33.99,
   "quien": "humano",
   "texto": "Entendido.",
   "plano": "dos",
   "emocion": "feliz"
  },
  {
   "inicio": 33.99,
   "fin": 38,
