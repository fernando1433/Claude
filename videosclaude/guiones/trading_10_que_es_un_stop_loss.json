   "emocion": "ilusionado"
  },
  {
   "inicio": 24.08,
   "fin": 27.69,
   "quien": "claude",
   "texto": "«Solo un poquito».\nAsí empiezan las desgracias.",
   "plano": "monitor",
   "claude_estado": "feliz"
  },
  {
   "inicio": 27.69,
   "fin": 29.3,
   "quien": "humano",
   "texto": "¿Es perfecto?",
