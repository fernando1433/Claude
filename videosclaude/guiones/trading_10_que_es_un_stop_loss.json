   "emocion": "bobo"
  },
  {
   "inicio": 17.75,
   "fin": 21.5,
   "quien": "claude",
   "texto": "A lo mejor. Y a lo mejor no.\nPor eso es un freno.",
   "plano": "pantalla_completa"
  },
  {
