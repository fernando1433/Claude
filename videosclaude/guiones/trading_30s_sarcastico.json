    {"inicio": 15.8, "fin": 17.0, "quien": "humano", "texto": "¿Y qué hago?", "plano": "humano", "pose": "pensar", "emocion": "preocupado", "tono": "dudoso"},
    {"inicio": 17.0, "fin": 19.8, "quien": "claude", "texto": "Ponle stop. Y no lo muevas\n«solo un poquito».", "plano": "pantalla_completa", "pantalla": {"tipo": "orden", "duracion": 4.0}},
